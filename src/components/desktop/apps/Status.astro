---
import statusData from '../../../data/chimera-status.json';

/**
 * Chimera homelab status card (#60). Renders the hand-maintained capture
 * committed at `src/data/chimera-status.json`. There is no live feed: the
 * daily sync depended on a self-hosted runner attached to this repo, which
 * is more operational surface than an occasionally-refreshed card justifies.
 * Refreshing this card means editing the JSON.
 */

interface ChimeraStatus {
	captured_at: string;
	uptime_seconds: number;
	containers: { running: number; stopped: number };
	array: { used_tb: number; total_tb: number; parity_state: string };
	smart_warnings: number;
}

const status: ChimeraStatus = statusData;

// Unraid reports a healthy parity disk as DISK_OK.
const HEALTHY_PARITY = new Set(['DISK_OK', 'healthy']);

function formatUptime(seconds: number): string {
	const days = Math.floor(seconds / 86400);
	const hours = Math.floor((seconds % 86400) / 3600);
	return `${days}d ${hours}h`;
}

function formatTB(used: number, total: number): string {
	// Floor, not round: a 99.5%-full array must not report as 100%.
	const pct = Math.floor((used / total) * 100);
	return `${used.toFixed(1)} / ${total.toFixed(1)} TB · ${pct}%`;
}

function fillSeverity(used: number, total: number): 'green' | 'yellow' | 'red' {
	const pct = (used / total) * 100;
	if (pct >= 95) return 'red';
	if (pct >= 85) return 'yellow';
	return 'green';
}

function row(severity: 'green' | 'yellow' | 'red' | 'gray', label: string, value: string) {
	return { severity, label, value };
}

const rows = [
	row('gray', 'uptime at capture', formatUptime(status.uptime_seconds)),
	row(
		status.containers.stopped > 0 ? 'yellow' : 'green',
		'docker containers',
		`${status.containers.running} running · ${status.containers.stopped} stopped`,
	),
	row(
		fillSeverity(status.array.used_tb, status.array.total_tb),
		'array fill',
		formatTB(status.array.used_tb, status.array.total_tb),
	),
	row(
		HEALTHY_PARITY.has(status.array.parity_state) ? 'green' : 'yellow',
		'parity',
		status.array.parity_state,
	),
	row(status.smart_warnings > 0 ? 'red' : 'green', 'smart warnings', String(status.smart_warnings)),
];
---

<article class="status">
	<h1>chimera.status</h1>
	<p class="status__intro">
		point-in-time capture of the unraid homelab box (`chimera`) — not a live feed. these numbers
		are committed by hand and are current only as of the capture date below.
	</p>

	<ul class="status__rows">
		{
			rows.map((r) => (
				<li class={`status__row status__row--${r.severity}`}>
					<span class="status__row-pill" aria-hidden="true" />
					<span class="status__row-label">{r.label}</span>
					<span class="status__row-value">{r.value}</span>
				</li>
			))
		}
	</ul>

	<p class="status__footer">
		captured: <code>{status.captured_at}</code>
	</p>
</article>

<style>
	.status {
		font-family: var(--font-screen);
		color: var(--ink);
		padding: 4px 0;
	}

	.status h1 {
		font-family: var(--font-pixel);
		font-size: 18px;
		margin: 0 0 12px;
	}

	.status__intro {
		font-size: 15px;
		color: var(--ink-soft);
		margin: 0 0 16px;
	}

	.status__rows {
		list-style: none;
		margin: 0 0 16px;
		padding: 0;
		display: grid;
		gap: 8px;
	}

	.status__row {
		display: grid;
		grid-template-columns: 12px 1fr auto;
		align-items: center;
		gap: 12px;
		padding: 10px 14px;
		background: var(--window-bg);
		border: 2px solid var(--border);
		border-radius: 6px;
		font-family: var(--font-mono);
		font-size: 14px;
	}

	.status__row-pill {
		display: inline-block;
		width: 12px;
		height: 12px;
		border-radius: 50%;
		border: 2px solid var(--border);
	}

	.status__row--green .status__row-pill {
		background: #6cff7d;
	}
	.status__row--yellow .status__row-pill {
		background: #ffd84a;
	}
	.status__row--red .status__row-pill {
		background: #ff4a6b;
	}
	.status__row--gray .status__row-pill {
		background: var(--ink-soft);
	}

	.status__row-label {
		color: var(--ink);
	}

	.status__row-value {
		color: var(--ink-primary);
		font-weight: 600;
	}

	.status__footer {
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--ink-soft);
		margin: 8px 0 0;
	}

	.status__footer code {
		font-family: var(--font-mono);
		background: var(--bg-deep);
		padding: 1px 5px;
		border-radius: 3px;
	}
</style>
